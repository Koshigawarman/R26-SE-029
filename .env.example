# Ollama connection settings
OLLAMA_URL=http://localhost:11434

# Server configuration
API_HOST=0.0.0.0
API_PORT=5000

# Agent Models
# These use the newest state-of-the-art models recommended for optimal performance.
PLANNER_MODEL=qwen2.5-coder:1.5b
CODEGEN_MODEL=qwen2.5-coder:7b
DEBUG_MODEL=qwen2.5-coder:1.5b

CRITIC_MODEL=qwen2.5-coder:1.5b

# TODO: No need test and remove later
# DEBUG_TIMEOUT=10000
# REQUEST_TIMEOUT=120

# Max retries for the debug loop
MAX_RETRIES=3

# OpenRouter Configuration (Optional)
USE_OPENROUTER=false
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Uncomment to test for free using openrouter
# PLANNER_MODEL=baidu/cobuddy:free
# CODEGEN_MODEL=baidu/cobuddy:free
# DEBUG_MODEL=baidu/cobuddy:free