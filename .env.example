# MAX_RETRIES=3


# Ollama connection settings
OLLAMA_URL=http://localhost:11434

# Server configuration
API_HOST=0.0.0.0
API_PORT=5000

# Agent Models
# Use the same Modal-hosted Qwen Coder model for all agents for now.
PLANNER_MODEL=Qwen/Qwen2.5-Coder-3B-Instruct
CODEGEN_MODEL=Qwen/Qwen2.5-Coder-3B-Instruct
DEBUG_MODEL=Qwen/Qwen2.5-Coder-3B-Instruct
CRITIC_MODEL=Qwen/Qwen2.5-Coder-3B-Instruct

# TODO: No need test and remove later
# DEBUG_TIMEOUT=10000
# REQUEST_TIMEOUT=120

# Max retries for the debug loop
MAX_RETRIES=3

# Generic OpenAI-compatible provider configuration (Optional)
# Use this for Modal vLLM or any /v1/chat/completions endpoint.
USE_OPENAI_COMPATIBLE=true
OPENAI_COMPATIBLE_PROVIDER=modal
OPENAI_COMPATIBLE_URL=https://pahitharandilakshan--qwen-coder-3b-vllm-server.us-east.modal.direct/v1/chat/completions
OPENAI_COMPATIBLE_API_KEY=

# Modal example:
MODEL_TIMEOUT=240
