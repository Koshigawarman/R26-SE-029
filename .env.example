# OLLAMA_URL=http://localhost:11434
# PLANNER_MODEL=qwen2.5-coder:1.5b
# CODEGEN_MODEL=qwen2.5-coder:1.5b
# CRITIC_MODEL=qwen2.5-coder:1.5b
# DEBUG_TIMEOUT=10000
# MAX_RETRIES=3


# Ollama connection settings
OLLAMA_URL=http://localhost:11434

# Server configuration
API_HOST=0.0.0.0
API_PORT=5000

# Agent Models
# These use the newest state-of-the-art models recommended for optimal performance.
PLANNER_MODEL=qwen2.5-coder:1.5b
CODEGEN_MODEL=qwen2.5-coder:7b
DEBUG_MODEL=qwen2.5-coder:1.5b
CRITIC_MODEL=qwen2.5-coder:1.5b

# TODO: No need test and remove later
# DEBUG_TIMEOUT=10000
# REQUEST_TIMEOUT=120

# Max retries for the debug loop
MAX_RETRIES=3

# Generic OpenAI-compatible provider configuration (Optional)
# Use this for Modal vLLM or any /v1/chat/completions endpoint.
USE_OPENAI_COMPATIBLE=false
OPENAI_COMPATIBLE_PROVIDER=modal
OPENAI_COMPATIBLE_URL=https://your-modal-endpoint.modal.run/v1/chat/completions
OPENAI_COMPATIBLE_API_KEY=your_modal_or_provider_key_here

# Modal example:
# USE_OPENAI_COMPATIBLE=true
# OPENAI_COMPATIBLE_PROVIDER=modal
# OPENAI_COMPATIBLE_URL=https://your-workspace--your-app-serve.modal.run/v1/chat/completions
# OPENAI_COMPATIBLE_API_KEY=
# PLANNER_MODEL=Qwen/Qwen2.5-Coder-7B-Instruct
# CODEGEN_MODEL=Qwen/Qwen2.5-Coder-7B-Instruct
# DEBUG_MODEL=Qwen/Qwen2.5-Coder-7B-Instruct

MODEL_TIMEOUT=240
